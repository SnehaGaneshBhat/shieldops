# ShieldOps / BuildGuard Environment Configuration

# Google Gemini API configuration for AI-assisted security report explanations
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Legacy configuration compatibility (optional fallback)
