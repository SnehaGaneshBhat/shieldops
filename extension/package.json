{
  "name": "buildguard",
  "displayName": "BuildGuard",
  "description": "Supply-chain checks for dependencies, builds and compilers.",
  "version": "0.1.0",
  "publisher": "buildguard-team",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Other"],
  "main": "./dist/extension.js",
  "files": ["dist/**", "README.md", "package.json"],
  "contributes": {
    "commands": [
      { "command": "buildguard.scan", "title": "BuildGuard: Scan Workspace" },
      { "command": "buildguard.showReport", "title": "BuildGuard: Show Last Report" },
      { "command": "buildguard.exportHtml", "title": "BuildGuard: Export Report as HTML" },
      { "command": "buildguard.clearDiagnostics", "title": "BuildGuard: Clear Problems" }
    ],
    "configuration": { "title": "BuildGuard", "properties": {
      "buildguard.backendUrl": { "type": "string", "default": "http://127.0.0.1:8787", "description": "URL of the BuildGuard backend." },
      "buildguard.token": { "type": "string", "default": "", "description": "Shared token for a manually started backend." },
      "buildguard.useLLM": { "type": "boolean", "default": true, "description": "Request generated explanations from structured findings; turn off to use template explanations." },
      "buildguard.autoStartBackend": { "type": "boolean", "default": true, "description": "Start backend when unavailable (requires buildguard.backendCwd)." },
      "buildguard.backendCwd": { "type": "string", "default": "", "description": "Repository path containing .venv and backend/." },
      "buildguard.modules": { "type": "array", "items": { "type": "string", "enum": ["dependency", "build", "compiler"] }, "default": ["dependency", "build", "compiler"], "description": "Analysis modules to request." },
      "buildguard.recipePath": { "type": "string", "default": "buildguard.yml", "description": "Build recipe path relative to the workspace." },
      "buildguard.manifestPath": { "type": "string", "default": "", "description": "Optional trusted release manifest path relative to the workspace." },
      "buildguard.distributedArtifact": { "type": "string", "default": "", "description": "Optional distributed artifact path relative to the workspace; set together with buildguard.manifestPath." },
      "buildguard.compilerSample": { "type": "string", "default": "", "description": "Optional C/Linux ELF sample directory inside the workspace. Leave empty to skip compiler analysis rather than scan a demo fixture." }
    } }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:backend",
    "test:backend": "make -C .. test",
    "mock": "node test/mock-server.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o ../buildguard-0.1.0.vsix"
  },
  "devDependencies": { "@types/node": "^20.17.0", "@types/vscode": "^1.85.0", "@vscode/vsce": "^3.2.1", "esbuild": "^0.21.5", "typescript": "^5.7.2" }
}
