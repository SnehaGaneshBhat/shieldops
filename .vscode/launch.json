
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run BuildGuard Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
          "${workspaceFolder}",
          "--extensionDevelopmentPath=${workspaceFolder}/extension",
          "--disable-extensions",
          "--disable-gpu"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js"
      ]
    }
  ]
}
